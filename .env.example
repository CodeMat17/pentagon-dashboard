# Convex — written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk — from the Clerk dashboard, API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends people. Sign-up is open, but a new account has no dashboard
# access until an admin grants it a role under Staff.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Set on the Convex deployment itself, NOT here:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<subdomain>.clerk.accounts.dev

# ---------------------------------------------------------------------------
# Guest notifications — set on the CONVEX deployment, not here. The actions in
# convex/notify.ts read them at send time; a missing key makes that channel a
# logged "skipped", never a failed booking.
#
#   npx convex env set RESEND_API_KEY re_...
#   npx convex env set RESEND_FROM "Pentagon Hotel and Suites <info@pentagoninternationalhotel.com>"
#   npx convex env set SITE_URL https://pentagoninternationalhotel.com
#   npx convex env set ROBASE_API_KEY robe_...
#
# Robase (SMS) is billed per message, so it carries the confirmation and the
# cancellation only — one line and a link each. The reminders the evening before
# arrival and on the morning itself go by email alone, and never on the same day
# the booking was made.
